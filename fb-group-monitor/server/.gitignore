# Firebase Admin service account key — NEVER commit this (full DB write access)
serviceAccount.json

# Local SQLite DB, backups + WAL sidecar files (hold scraped phone numbers)
rides*.db
rides*.db-wal
rides*.db-shm

# Export staging folder for moving the DB between machines (export-bundle.js).
# Ignore the whole directory, not just *.db, so nothing in it can slip out.
bundle/

node_modules/
